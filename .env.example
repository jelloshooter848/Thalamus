# Required: THALAMUS will not start without a TypeSafe API key (JEV powers every System-1 region).
TYPESAFE_API_KEY=
# Required for the cortex (prefrontal cortex + Broca's area).
ANTHROPIC_API_KEY=
# Only if your Anthropic key "works across workspaces": the workspace ID (starts with wrkspc_).
ANTHROPIC_WORKSPACE_ID=
# Optional: lets THALAMUS search the web (app.tavily.com, free tier available).
TAVILY_API_KEY=
